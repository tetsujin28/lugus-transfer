{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lugus Transfer",
  "version": "0.3.0",
  "identifier": "com.domingoolmomartin.lugus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lugus Transfer",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#0d0e10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Domingo Olmo Martin",
    "copyright": "© 2026 Domingo Olmo Martin. MIT License.",
    "category": "Video",
    "shortDescription": "Transfert pair à pair de très gros fichiers vidéo",
    "longDescription": "Lugus Transfer envoie des rushes directement d'une machine à l'autre, sans serveur, avec un lien et un code, et vérifie chaque fichier sur le disque de destination."
  }
}
